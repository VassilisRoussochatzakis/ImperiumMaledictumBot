# Copy to .env and fill in. Never commit .env.
# Bot token from the Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Database path for the plain-Python run. Docker ignores this: compose.yaml mounts ./data
# into the container and sets DB_PATH=/data/characters.db itself.
DB_PATH=data/characters.db

# Optional: a server ID to sync commands to instantly while testing.
# Leave empty for global commands (can take up to an hour to appear the first time).
DEV_GUILD_ID=

# Optional: INFO (default) or WARNING. DEBUG logs every Discord request body, card contents included.
LOG_LEVEL=INFO
